\begin_layout Section
Standard RBC
\end_layout

\begin_layout Standard
Agent solves 
\begin_inset Formula 
\begin{equation}
\max\sum^{\infty}_{t=1}\beta^{t}\mathbb{E}_{t}\frac{c^{1-\gamma}_{t}}{1-\gamma},\forall t=1\ldots\infty
\end{equation}

\end_inset

subject to 
\begin_inset Formula 
\[
c_{t}+k_{t+1}=A_{t}k^{\alpha}_{t}+(1-\delta)k_{t}
\]

\end_inset

The first-order conditions are
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\beta^{t}c^{-\gamma}_{t}= & \lambda_{t}\\
\lambda_{t}= & \mathbb{E}_{t}\lambda_{t+1}(A_{t+1}k^{\alpha-1}_{t+1}+1-\delta)
\end{align*}

\end_inset

So our Euler equation is 
\begin_inset Formula 
\begin{equation}
\frac{1}{c^{\gamma}_{t}}=\mathbb{E}_{t}\frac{1}{c^{\gamma}_{t+1}}(A_{t+1}k^{\alpha-1}_{t+1}+1-\delta)
\end{equation}

\end_inset


\end_layout

\begin_layout Section
RBC with labor 
\end_layout

\begin_layout Standard
Agent solves 
\begin_inset Formula 
\begin{equation}
\max\sum^{\infty}_{t=1}\beta^{t}\mathbb{E}_{t}\frac{c^{1-\gamma}_{t}}{1-\gamma}-\chi\cdot\frac{n^{1+\frac{1}{\nu}}_{t}}{1+\frac{1}{\nu}}
\end{equation}

\end_inset

subject to 
\begin_inset Formula 
\[
c_{t}+k_{t+1}=A_{t}k^{\alpha}_{t}n^{1-\alpha}_{t}+(1-\delta)k_{t}
\]

\end_inset

So the first-order conditions are
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\beta^{t}c^{-\gamma}_{t}= & \lambda_{t}\\
\chi n^{\frac{1}{\nu}}_{t}= & \lambda_{t}(1-\alpha)A_{t}k^{\alpha}_{t}n^{-\alpha}_{t}\\
\lambda_{t}= & \mathbb{E}_{t}\lambda_{t+1}\left({A_{t+1}}k^{\alpha-1}_{t+1}n^{\alpha}_{t}+1-\delta\right)
\end{align*}

\end_inset

So the 2 optimal conditions are
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
n^{\frac{1}{\nu}}_{t}= & \frac{1}{\chi}\cdot c^{-\gamma}_{t}(1-\alpha)A_{t}k^{\alpha}_{t}n^{-\alpha}_{t}\\
c^{-\gamma}_{t}= & \mathbb{E}_{t}c^{-\gamma}_{t+1}\left({A_{t+1}}k^{\alpha-1}_{t+1}n^{\alpha-1}_{t+1}+1-\delta\right)
\end{align*}

\end_inset

Since the intratemporal condition is uniquely pin down by the choice of 
\begin_inset Formula $c_{t}$
\end_inset

,
 
\begin_inset Formula 
\[
n^{\frac{1}{\gamma}+\alpha}_{t}=\frac{1}{\chi}\cdot c^{-\gamma}_{t}(1-\alpha)A_{t}k^{\alpha}_{t}
\]

\end_inset

We can write the Euler equation solely in 
\begin_inset Formula $c_{t}$
\end_inset

 
\begin_inset Formula 
\begin{equation}
\begin{array}{ll}
c^{-\gamma}_{t}= & \mathbb{E}_{t}c^{-\gamma}_{t+1}\left[{A_{t+1}}k^{\alpha-1}_{t+1}\left(\frac{1}{\chi}\cdot c^{-\gamma}_{t+1}(1-\alpha)A_{t+1}k^{\alpha}_{t+1}\right)^{\alpha-1\left(\frac{1}{\gamma}+\alpha\right)}+1-\delta\right]\end{array}
\end{equation}

\end_inset


\end_layout

